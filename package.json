{
  "name": "siempre-de-local",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait db",
    "db:generate": "pnpm --filter @sdl/api db:generate",
    "db:migrate": "pnpm --filter @sdl/api db:migrate",
    "db:check": "pnpm --filter @sdl/api db:check",
    "db:seed": "pnpm --filter \"@sdl/api...\" build && pnpm --filter @sdl/api db:seed",
    "admin:bootstrap-team": "pnpm --filter \"@sdl/api...\" build && pnpm --filter @sdl/api admin:bootstrap-team",
    "proxy:up": "docker compose up -d proxy",
    "spike:pwa": "bash scripts/spike-pwa.sh",
    "proxy:cert": "mkdir -p .certs && docker compose cp proxy:/data/caddy/pki/authorities/local/root.crt .certs/caddy-local-root.crt"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sdl/config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
