{
  "name": "@sdl/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "NODE_OPTIONS=--conditions=@sdl/source drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=--conditions=@sdl/source drizzle-kit migrate",
    "db:check": "NODE_OPTIONS=--conditions=@sdl/source drizzle-kit check",
    "dev": "tsc -p tsconfig.build.json && (TSC_WATCHFILE=DynamicPriorityPolling TSC_WATCHDIRECTORY=DynamicPriorityPolling tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=.env dist/main.js)",
    "start": "node dist/main.js",
    "db:seed": "node --env-file-if-exists=.env dist/scripts/seed.js",
    "bank:lint": "tsc -p tsconfig.build.json && node dist/scripts/lint-banks.js",
    "admin:bootstrap-team": "node --env-file-if-exists=.env dist/scripts/bootstrap-team.js",
    "admin:seed-demo": "node --env-file-if-exists=.env dist/scripts/seed-demo.js",
    "db:migrate:prod": "node dist/scripts/migrate.js"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@nestjs/throttler": "6.7.1",
    "@sdl/contracts": "workspace:*",
    "@sdl/domain": "workspace:*",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@sdl/config": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
