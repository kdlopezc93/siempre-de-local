# Copia este archivo a apps/api/.env y rellena los valores. Nunca subas .env al repo.

# Base de datos local: pnpm db:up
DATABASE_URL=postgres://sdl:sdl@localhost:5432/sdl

# Puerto del API (Caddy lo publica en https://api.sdl.localtest.me)
PORT=3000

# --- Auth (Better Auth + Google) ---
# URL pública del API y origen de la PWA, servidos por Caddy (pnpm proxy:up)
BETTER_AUTH_URL=https://api.sdl.localtest.me
WEB_ORIGIN=https://app.sdl.localtest.me
# Dominio padre compartido por app. y api. para la cookie de sesión
COOKIE_DOMAIN=sdl.localtest.me
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google Cloud Console → Google Auth Platform → Clientes (tipo "Aplicación web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Avisos (Web Push). Sin las tres, quedan apagados. Generarlas: npx web-push generate-vapid-keys
# La pública no es secreta; la privada sí (nunca en el repo).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Tareas programadas (POST /api/v1/cron/*): Authorization: Bearer <CRON_SECRET>, 32+ caracteres.
# Sin ella, esas rutas responden 404. `openssl rand -hex 32`
CRON_SECRET=
