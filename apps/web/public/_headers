# Cloudflare Pages (docs/deploy.md). El build pone la CSP de vite.config.ts en su marcador.
/*
  Content-Security-Policy: __CSP__
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# El service worker y el manifiesto siempre se revalidan: si no, una versión nueva tarda en llegar.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
